# Firebase Web App config for "pixel-productivity" (project: dpomodoro-f7b6c).
#
# Copy this file to `.env` and paste the real values from:
#   Firebase console > Project settings > Your apps > pixel-productivity > "Config"
#
# Vite only embeds variables prefixed with VITE_, so these ship to the browser.
# The app runs localStorage-only when no real API key is present — `isFirebaseConfigured()`
# checks for a key that starts with "AIzaSy" and is 39 characters long.
VITE_FIREBASE_API_KEY=REPLACE_WITH_YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=dpomodoro-f7b6c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dpomodoro-f7b6c
VITE_FIREBASE_STORAGE_BUCKET=dpomodoro-f7b6c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=363730407667
VITE_FIREBASE_APP_ID=1:363730407667:web:5861c1bcdf6fcb6a1c2786
VITE_FIREBASE_MEASUREMENT_ID=G-J1Y8Z38HMC

# Absolute path to the Obsidian vault folder the weekly report is written to.
# Optional — the vault folder can also be picked from the app at runtime.
VITE_OBSIDIAN_VAULT_PATH=

# reCAPTCHA v3 site key for Firebase App Check.
#
# Optional, but recommended: without it, anyone who finds the app can use
# this Firebase project from a script (the Web API key is public by design).
# App Check makes the backend require a token only a genuine instance of the
# app can obtain. Create the key in Firebase console > App Check, then set
# enforcement once you have confirmed sign-in and sync still work.
# See SECURITY.md for the full rollout order.
VITE_FIREBASE_APPCHECK_SITE_KEY=
